local P, R = game:GetService("Players"), game:GetService("ReplicatedStorage")
local pl, ev = P.LocalPlayer, R:WaitForChild("rEvents")
local pGui = pl:WaitForChild("PlayerGui")
if pGui:FindFirstChild("GeckoGUI") then pGui.GeckoGUI:Destroy() end
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.Parent = "GeckoGUI", false, pGui
local main = Instance.new("Frame")
main.Size, main.Position, main.AnchorPoint = UDim2.fromOffset(420, 280), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5)
main.BackgroundColor3, main.BorderSizePixel, main.Parent = Color3.fromRGB(20, 20, 20), 0, gui
local corner = Instance.new("UICorner")
corner.CornerRadius, corner.Parent = UDim.new(0, 12), main
local fRegular, fBold = Font.fromName("Montserrat", Enum.FontWeight.Regular), Font.fromName("Montserrat", Enum.FontWeight.Bold)
local title = Instance.new("TextLabel")
title.Size, title.Position, title.BackgroundTransparency = UDim2.new(1, -30, 0, 45), UDim2.fromOffset(15, 10), 1
title.Text, title.TextColor3, title.TextSize, title.FontFace, title.TextXAlignment, title.Parent = "Gecko", Color3.new(1, 1, 1), 24, fBold, Enum.TextXAlignment.Left, main
local subtitle = Instance.new("TextLabel")
subtitle.Size, subtitle.Position, subtitle.BackgroundTransparency = UDim2.new(1, -30, 0, 25), UDim2.fromOffset(15, 52), 1
subtitle.Text, subtitle.TextColor3, subtitle.TextSize, subtitle.FontFace, subtitle.TextXAlignment, subtitle.Parent = "Muscle Legends All-In-One", Color3.fromRGB(170, 170, 170), 14, fRegular, Enum.TextXAlignment.Left, main
local separator = Instance.new("Frame")
separator.Size, separator.Position, separator.BackgroundColor3, separator.BorderSizePixel, separator.Parent = UDim2.new(1, -30, 0, 1), UDim2.fromOffset(15, 85), Color3.fromRGB(50, 50, 50), 0, main
local status = Instance.new("TextLabel")
status.Size, status.Position, status.BackgroundColor3 = UDim2.new(1, -30, 0, 35), UDim2.fromOffset(15, 105), Color3.fromRGB(50, 50, 50)
status.Text, status.TextColor3, status.TextSize, status.FontFace, status.TextXAlignment, status.Parent = "  Status: System Idle", Color3.fromRGB(220, 220, 220), 14, Font.fromName("Montserrat", Enum.FontWeight.Medium), Enum.TextXAlignment.Left, main
local statusCorner = Instance.new("UICorner")
statusCorner.CornerRadius, statusCorner.Parent = UDim.new(0, 8), status
local button = Instance.new("TextButton")
button.Size, button.Position, button.BackgroundColor3 = UDim2.new(1, -30, 0, 45), UDim2.fromOffset(15, 155), Color3.fromRGB(90, 90, 90)
button.Text, button.TextColor3, button.TextSize, button.FontFace, button.AutoButtonColor, button.Parent = "Activate Super Auto", Color3.new(1, 1, 1), 16, fBold, true, main
local bCorner = Instance.new("UICorner")
bCorner.CornerRadius, bCorner.Parent = UDim.new(0, 8), button
_G.SuperAuto = false
button.MouseButton1Click:Connect(function()
	_G.SuperAuto = not _G.SuperAuto
	if _G.SuperAuto then
		status.Text, button.Text, button.BackgroundColor3 = "  Status: ALL AUTO RUNNING...", "Deactivate Super Auto", Color3.fromRGB(180, 40, 40)
		
		task.spawn(function()
			local rEv = ev:WaitForChild("rebirthEvent")
			local oEv = ev:WaitForChild("openCrystalEvent")
			local tick = 0
			while _G.SuperAuto do
				local ch = pl.Character
				local tool = ch and ch:FindFirstChildOfClass("Tool")
				if tool then
					tool:Activate()
				else
					local bp = pl:FindFirstChild("Backpack")
					local tl = bp and bp:FindFirstChildOfClass("Tool")
					if tl then tl.Parent = ch end
				end
				tick = tick + 1
				if tick % 8 == 0 then oEv:FireServer("openCrystal", "Blue Crystal") end
				if tick % 30 == 0 then rEv:FireServer("rebirthRequest") end
				task.wait(0.05)
			end
		end)
	else
		status.Text, button.Text, button.BackgroundColor3 = "  Status: System Idle", "Activate Super Auto", Color3.fromRGB(90, 90, 90)
	end
end)
local close = Instance.new("TextButton")
close.Size, close.Position, close.BackgroundColor3 = UDim2.fromOffset(30, 30), UDim2.new(1, -40, 0, 12), Color3.fromRGB(50, 50, 50)
close.Text, close.TextColor3, close.TextSize, close.FontFace, close.Parent = "X", Color3.new(1, 1, 1), 14, fBold, main
local cCorner = Instance.new("UICorner")
cCorner.CornerRadius, cCorner.Parent = UDim.new(0, 8), close
close.MouseButton1Click:Connect(function()
	_G.SuperAuto = false
	gui:Destroy()
end)
