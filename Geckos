local checking = false
local function checkKey()
    if checking then return end
    local input = keyBox.Text:lower():gsub("%s+", "")
    if input == "geckomus" then
        checking = true
        statusLbl.TextColor3 = Color3.fromRGB(110, 220, 140)
        statusLbl.Text = "Key accepted"
        task.wait(0.2)
        tween(keyFrame, 0.3, { Size = UDim2.fromOffset(320, 200), BackgroundTransparency = 1 })
        task.wait(0.3)
        keyFrame:Destroy()
        createMainGUI()
        startLoops()
    else
        statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
        statusLbl.Text = "Invalid key"
        local origPos = keyBox.Position
        for i = 1, 3 do
            tween(keyBox, 0.08, { Position = UDim2.fromOffset(origPos.X.Offset - 3, origPos.Y.Offset) })
            task.wait(0.1)
            tween(keyBox, 0.08, { Position = UDim2.fromOffset(origPos.X.Offset + 3, origPos.Y.Offset) })
            task.wait(0.1)
        end
        tween(keyBox, 0.08, { Position = origPos })
    end
end

unlockBtn.MouseButton1Click:Connect(checkKey)
keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then checkKey() end
end)
