local button = Instance.new("TextButton")
button.Size, button.Position, button.BackgroundColor3 = UDim2.new(1, -30, 0, 45), UDim2.fromOffset(15, 155), Color3.fromRGB(90, 90, 90)
button.Text, button.TextColor3, button.TextSize, button.FontFace, button.AutoButtonColor, button.Parent = "Activate Super Auto", Color3.new(1, 1, 1), 16, fBld, true, main
Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

_G.SuperAuto = false
button.MouseButton1Click:Connect(function()
	_G.SuperAuto = not _G.SuperAuto
	if _G.SuperAuto then
		status.Text, button.Text, button.BackgroundColor3 = "  Status: ALL AUTO RUNNING...", "Deactivate Super Auto", Color3.fromRGB(180, 40, 40)
		task.spawn(function()
			local rEv = ev:WaitForChild("rebirthEvent")
			local oEv = ev:WaitForChild("openCrystalEvent")
			local tick = 0
			while _G.SuperAuto do
				local ch = pl.Character
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local tool = ch:FindFirstChildOfClass("Tool")
					if tool then
						tool:Activate()
					else
						local bp = pl:FindFirstChild("Backpack")
						local tl = bp and bp:FindFirstChildOfClass("Tool")
						if tl then hum:EquipTool(tl) end
					end
				end
				tick = tick + 1
				if tick % 15 == 0 then oEv:FireServer("openCrystal", "Blue Crystal") end
				if tick % 45 == 0 then rEv:FireServer("rebirthRequest") end
				task.wait(0.02)
			end
		end)
	else
		status.Text, button.Text, button.BackgroundColor3 = "  Status: System Idle", "Activate Super Auto", Color3.fromRGB(90, 90, 90)
	end
end)

