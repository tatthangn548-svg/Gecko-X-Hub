local function checkKey()
	local input = keyBox.Text:lower():gsub("%s+", "")

	if input == "geckomus" then
		status.Text = "Key accepted"

		tween(keyFrame, 0.35, {
			Size = UDim2.fromOffset(700, 570),
			BackgroundTransparency = 1
		})

		task.wait(0.35)

		keyFrame:Destroy()
		showMain()
	else
		status.Text = "Invalid key"
		tween(keyBox, 0.12, {
			Position = UDim2.fromOffset(40, 145)
		})
		task.wait(0.06)
		tween(keyBox, 0.12, {
			Position = UDim2.fromOffset(45, 145)
		})
	end
end

mainButton.MouseButton1Click:Connect(checkKey)

keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		checkKey()
	end
end)
