_G.SuperAutoActive = false

button.MouseButton1Click:Connect(function()
	_G.SuperAutoActive = not _G.SuperAutoActive
	
	if _G.SuperAutoActive then
		status.Text = "  Status: ALL AUTO RUNNING..."
		button.Text = "Deactivate Super Auto"
		button.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		
		task.spawn(function()
			local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
			local muscleEvent = rEvents and rEvents:FindFirstChild("muscleEvent")
			local rebirthEvent = rEvents and rEvents:FindFirstChild("rebirthEvent")
			local openCrystalEvent = rEvents and rEvents:FindFirstChild("openCrystalEvent")
			
			if muscleEvent and rebirthEvent and openCrystalEvent then
				while _G.SuperAutoActive do
					muscleEvent:FireServer("liftWeight")
					muscleEvent:FireServer("pushups")
					muscleEvent:FireServer("treadmill")
					openCrystalEvent:FireServer("openCrystal", "Blue Crystal")
					
					local character = player.Character
					if character and not character:FindFirstChildOfClass("Tool") then
						local backpack = player:FindFirstChild("Backpack")
						local tool = backpack and backpack:FindFirstChildOfClass("Tool")
						if tool then
							tool.Parent = character
						end
					end
					
					task.wait(0.01)
				end
			end
		end)
		
		task.spawn(function()
			local rebirthEvent = ReplicatedStorage:FindFirstChild("rEvents") and ReplicatedStorage.rEvents:FindFirstChild("rebirthEvent")
			if rebirthEvent then
				while _G.SuperAutoActive do
					rebirthEvent:FireServer("rebirthRequest")
					task.wait(1)
				end
			end
		end)
		
	else
		status.Text = "  Status: System Idle"
		button.Text = "Activate Super Auto"
		button.BackgroundColor3 = Config.AccentColor
	end
end)

