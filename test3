local function findTarget(keywords, excludeWords)
    local function matches(name)
        local lower = name:lower()
        for _, ex in ipairs(excludeWords) do
            if lower:find(ex:lower()) then return false end
        end
        for _, kw in ipairs(keywords) do
            if lower:find(kw:lower()) then return true end
        end
        return false
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and matches(obj.Name) and obj.PrimaryPart then
            return obj.PrimaryPart
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and matches(obj.Name) then
            return obj
        end
    end
    return nil
end

local function interact(part)
    if not part then return end
    local pp = part:FindFirstChildOfClass("ProximityPrompt")
    if pp and pp.Enabled then
        pcall(function()
            pp:InputHoldBegin()
            wait(0.05)
            pp:InputHoldEnd()
        end)
        return
    end
    local cd = part:FindFirstChildOfClass("ClickDetector")
    if cd then
        pcall(function() cd:FireServer() end)
        return
    end
    local re = part:FindFirstChildOfClass("RemoteEvent")
    if re then
        pcall(function() re:FireServer() end)
        return
    end
end

local function interactAll(keywords)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, kw in ipairs(keywords) do
                if obj.Name:lower():find(kw:lower()) then
                    interact(obj)
                    break
                end
            end
        end
    end
end

local function autoRock(rockKeywords)
    if not rootPart then return end
    local targetRock = findTarget(rockKeywords, {})
    if not targetRock then return end

    local tool = nil
    for _, t in ipairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") and (t.Name:lower():find("punch") or t.Name:lower():find("boxing") or t.Name:lower():find("fight")) then
            tool = t
            break
        end
    end
    if not tool and character then
        for _, t in ipairs(character:GetChildren()) do
            if t:IsA("Tool") then tool = t; break end
        end
    end
    if not tool then return end

    if tool.Parent == player.Backpack then
        humanoid:EquipTool(tool)
        wait(0.1)
    end

    if tool.Parent == character then
        rootPart.CFrame = CFrame.lookAt(rootPart.Position, targetRock.Position)
        wait(0.05)
        tool:Activate()
        local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("ActivateRemote")
        if remote then remote:FireServer() end
    end
end

local function mainLoop()
    while running do
        pcall(function()
            if flags.AutoWeight then interactAll(CONFIG.AutoWeight) end
            if flags.AutoLift then interactAll(CONFIG.AutoLift) end
            if flags.AutoFarm then interactAll(CONFIG.AutoFarm) end

            if flags.AutoRebirth then
                local ls = player:FindFirstChild("leaderstats")
                if ls then
                    local rb = ls:FindFirstChild("Rebirths") or ls:FindFirstChild("Rebirth")
                    if rb and rb.Value >= 1 then
                        interactAll(CONFIG.Rebirth)
                    end
                end
            end

            if flags.AutoKill and rootPart then
                local targetName = flags.KillTarget
                local target = (targetName ~= "") and Players:FindFirstChild(targetName)
                if not target or not target.Character then
                    local maxDist = 500
                    local nearest = nil
                    local myPos = rootPart.Position
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                            if d < maxDist then maxDist = d; nearest = p end
                        end
                    end
                    target = nearest
                end
                if target and target.Character then
                    local tool = nil
                    for _, t in ipairs(player.Backpack:GetChildren()) do
                        if t:IsA("Tool") and (t.Name:lower():find("punch") or t.Name:lower():find("sword") or t.Name:lower():find("weapon")) then
                            tool = t; break
                        end
                    end
                    if not tool and character then
                        for _, t in ipairs(character:GetChildren()) do
                            if t:IsA("Tool") then tool = t; break end
                        end
                    end
                    if tool then
                        if tool.Parent == player.Backpack then humanoid:EquipTool(tool) end
                        if tool.Parent == character then
                            rootPart.CFrame = CFrame.lookAt(rootPart.Position, target.Character.HumanoidRootPart.Position)
                            tool:Activate()
                        end
                    end
                end
            end

            if flags.AutoBadKarma then interactAll(CONFIG.BadKarma) end
            if flags.AutoGoodKarma then interactAll(CONFIG.GoodKarma) end

            if flags.AutoRock100k then autoRock(CONFIG.Rocks["100k"]) end
            if flags.AutoRock350k then autoRock(CONFIG.Rocks["350k"]) end
            if flags.AutoRock750k then autoRock(CONFIG.Rocks["750k"]) end
            if flags.AutoRock1m then autoRock(CONFIG.Rocks["1m"]) end
            if flags.AutoRock10m then autoRock(CONFIG.Rocks["10m"]) end

            for _, tp in ipairs(CONFIG.Teleports) do
                if flags[tp.flag] then
                    if tp.flag == "TeleAll" then
                        local islands = {}
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") and obj.PrimaryPart then
                                for _, kw in ipairs(tp.kw) do
                                    if obj.Name:lower():find(kw:lower()) then
                                        table.insert(islands, obj.PrimaryPart)
                                        break
                                    end
                                end
                            elseif obj:IsA("BasePart") then
                                for _, kw in ipairs(tp.kw) do
                                    if obj.Name:lower():find(kw:lower()) then
                                        table.insert(islands, obj)
                                        break
                                    end
                                end
                            end
                        end
                        for _, part in ipairs(islands) do
                            if rootPart then rootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0) end
                            wait(1)
                        end
                    else
                        local part = findTarget(tp.kw, tp.ex)
                        if part and rootPart then
                            rootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                end
            end

            if flags.BuyBlueCrystal then interactAll(CONFIG.BlueCrystal) end
            if flags.BuyGreenCrystal then interactAll(CONFIG.GreenCrystal) end
            if flags.BuyDarkstar then interactAll(CONFIG.Darkstar) end
            if flags.AutoEvolve then
                interactAll(CONFIG.Evolve)
                local btn = playerGui:FindFirstChild("EvolveButton") or playerGui:FindFirstChild("Evolve")
                if btn and btn:IsA("TextButton") and btn.Visible then
                    pcall(function() btn.MouseButton1Click:Fire() end)
                end
            end
        end)
        wait(0.5)
    end
end

local function startLoops()
    loops.SpeedJump = RunService.Heartbeat:Connect(function()
        if humanoid then
            humanoid.WalkSpeed = flags.SpeedBoost and 120 or 16
            humanoid.JumpPower = flags.JumpPower and 150 or 50
        end
    end)

    loops.Fly = RunService.Heartbeat:Connect(function()
        if not humanoid or not rootPart then return end
        if flags.Fly then
            if not flyGyro then
                flyGyro = Instance.new("BodyGyro"); flyGyro.P = 9e4; flyGyro.Parent = rootPart
                flyVel = Instance.new("BodyVelocity"); flyVel.MaxForce = Vector3.new(9e9,9e9,9e9); flyVel.Parent = rootPart
            end
            flyGyro.CFrame = workspace.CurrentCamera.CFrame
            local dir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += workspace.CurrentCamera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= workspace.CurrentCamera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= workspace.CurrentCamera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += workspace.CurrentCamera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
            flyVel.Velocity = dir * 80
        else
            if flyGyro then flyGyro:Destroy() flyVel:Destroy() flyGyro, flyVel = nil, nil end
        end
    end)

    loops.Noclip = RunService.Stepped:Connect(function()
        if flags.Noclip and character then
            for _, p in ipairs(character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end
    end)

    loops.LongPunch = RunService.Heartbeat:Connect(function()
        if flags.LongPunch then
            local tool = nil
            for _, t in ipairs(player.Backpack:GetChildren()) do
                if t:IsA("Tool") and (t.Name:lower():find("punch") or t.Name:lower():find("boxing") or t.Name:lower():find("fight")) then
                    tool = t; break
                end
            end
            if not tool and character then
                for _, t in ipairs(character:GetChildren()) do
                    if t:IsA("Tool") then tool = t; break end
                end
            end
            if tool then
                if tool.Parent == player.Backpack then humanoid:EquipTool(tool) end
                if tool.Parent == character then tool:Activate() end
                local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("ActivateRemote")
                if remote then remote:FireServer() end
            end
        end
    end)

    spawn(mainLoop)
end

