local function createLabel(parent, name, size, position, text, textSize, font, color)
    local label = Instance.new("TextLabel")

    label.Name = name
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color or Color3.new(1, 1, 1)
    label.TextSize = textSize
    label.FontFace = font

    label.Parent = parent

    return label
end

