local checkingKey = false

local function checkKey()
    if checkingKey then
        return
    end

    checkingKey = true

    if textBox.Text == KEY then
        keyFrame.Visible = false
        main.Visible = true
        status.Text = "  Status: Key Accepted"
    else
        textBox.Text = ""
        textBox.PlaceholderText = "Wrong Key! Try Again..."
    end

    task.delay(0.25, function()
        checkingKey = false
    end)
end

kBtn.MouseButton1Click:Connect(checkKey)

textBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

