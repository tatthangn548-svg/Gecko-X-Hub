-- REMOTES
--==================================================

local function getRemotes()
    local folder = ReplicatedStorage:FindFirstChild("rEvents")
        or ReplicatedStorage

    return {
        Muscle = folder:FindFirstChild("muscleEvent"),
        Rebirth = folder:FindFirstChild("rebirthEvent"),
        Crystal = folder:FindFirstChild("openCrystalEvent")
    }
end

local function fireRemote(remote, ...)
    if not remote or not remote:IsA("RemoteEvent") then
        return false
    end

    local args = table.pack(...)

    local ok = pcall(function()
        remote:FireServer(table.unpack(args, 1, args.n))
    end)

    return ok
end

--==================================================
-- CHARACTER / TOOL
--==================================================

local function getHumanoid()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getEquippedTool()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Tool")
end

local function equipTool()
    local humanoid = getHumanoid()

    if not humanoid then
        return nil
    end

    local equipped = getEquippedTool()

    if equipped then
        return equipped
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local tool = backpack and backpack:FindFirstChildOfClass("Tool")

    if not tool then
        return nil
    end

    pcall(function()
        humanoid:EquipTool(tool)
    end)

    task.wait()

    return getEquippedTool()
end

--==================================================
-- AUTO ACTION
--==================================================

local function doAutoAction(remotes)
    if not SuperAuto then
        return
    end

    local tool = getEquippedTool() or equipTool()

    if not tool then
        return
    end

    pcall(function()
        tool:Activate()
    end)

    fireRemote(remotes.Muscle, "liftWeightRequest")
    fireRemote(remotes.Muscle, "gainMuscle")
end

--==================================================
-- STOP AUTO
--==================================================

local function stopAuto()
    SuperAuto = false

    status.Text = "  Status: System Idle"
    button.Text = "Activate Super Auto"
    button.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
end

--==================================================
-- START AUTO
--==================================================

local function startAuto()
    if autoThread then
        return
    end

    SuperAuto = true

    status.Text = "  Status: ALL AUTO RUNNING..."
    button.Text = "Deactivate Super Auto"
    button.BackgroundColor3 = Color3.fromRGB(180, 40, 40)

    autoThread = task.spawn(function()
        local remotes = getRemotes()

        local crystalTimer = 0
        local rebirthTimer = 0

        while SuperAuto and gui.Parent do
            local startTime = os.clock()

            doAutoAction(remotes)

            crystalTimer += AUTO_INTERVAL
            rebirthTimer += AUTO_INTERVAL

            if crystalTimer >= CRYSTAL_INTERVAL then
                crystalTimer = 0

                fireRemote(
                    remotes.Crystal,
                    "openCrystalRequest",
                    "Blue Crystal"
                )
            end

            if rebirthTimer >= REBIRTH_INTERVAL then
                rebirthTimer = 0

                fireRemote(
                    remotes.Rebirth,
                    "rebirthRequest"
                )
            end

            local elapsed = os.clock() - startTime
            task.wait(math.max(0, AUTO_INTERVAL - elapsed))
        end

        autoThread = nil
    end)
end

