-- Helper functions
local function fireProximityPromptOnParts(keyword)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find(keyword) then
            local pp = v:FindFirstChildOfClass("ProximityPrompt")
            if pp and pp.Enabled then
                pcall(function()
                    pp:InputHoldBegin()
                    task.wait(0.05)
                    pp:InputHoldEnd()
                end)
            end
        end
    end
end

local function fireRemoteOnPart(keyword)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find(keyword) then
            local re = v:FindFirstChildOfClass("RemoteEvent")
            if re then re:FireServer() return end
            local pp = v:FindFirstChildOfClass("ProximityPrompt")
            if pp and pp.Enabled then
                pcall(function()
                    pp:InputHoldBegin()
                    task.wait(0.05)
                    pp:InputHoldEnd()
                end)
            end
        end
    end
end

local function findTool(name)
    for _, t in ipairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(name:lower()) then return t end
    end
    if character then
        for _, t in ipairs(character:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find(name:lower()) then return t end
        end
    end
    return nil
end

local function getNearestPlayer(maxDist)
    if not rootPart then return nil end
    local nearest, dist = nil, maxDist or 500
    local myPos = rootPart.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pos = p.Character.HumanoidRootPart.Position
            local d = (pos - myPos).Magnitude
            if d < dist then
                dist = d
                nearest = p
            end
        end
    end
    return nearest
end

local function teleportTo(part)
    if part and rootPart then
        rootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    end
end

-- Vòng lặp chính thay thế spawn (có thể dừng)
local function mainLoop()
    while running do
        if flags.AutoWeight then fireRemoteOnPart("weight") fireProximityPromptOnParts("weight") end
        if flags.AutoLift then fireRemoteOnPart("lift") fireProximityPromptOnParts("lift") end
        if flags.AutoFarm then
            fireProximityPromptOnParts("coin")
            fireProximityPromptOnParts("ore")
            fireProximityPromptOnParts("collect")
            fireProximityPromptOnParts("farm")
            fireProximityPromptOnParts("gather")
        end
        if flags.AutoRebirth then
            local ls = player:FindFirstChild("leaderstats")
            if ls then
                local rb = ls:FindFirstChild("Rebirths") or ls:FindFirstChild("Rebirth")
                if rb and rb.Value >= 1 then fireRemoteOnPart("rebirth") end
            end
        end
        if flags.AutoKill and rootPart then
            local targetName = flags.KillTarget and flags.KillTarget ~= "" and flags.KillTarget
            local target = targetName and Players:FindFirstChild(targetName)
            if not target or not target.Character then target = getNearestPlayer(500) end
            if target and target.Character then
                local tool = findTool("punch") or findTool("sword") or findTool("weapon")
                if tool then
                    if tool.Parent == player.Backpack then humanoid:EquipTool(tool) end
                    if tool.Parent == character then
                        rootPart.CFrame = CFrame.lookAt(rootPart.Position, target.Character.HumanoidRootPart.Position)
                        tool:Activate()
                    end
                end
            end
        end
        if flags.AutoBadKarma then fireProximityPromptOnParts("bad") fireRemoteOnPart("bad") end
        if flags.AutoGoodKarma then fireProximityPromptOnParts("good") fireRemoteOnPart("good") end
        if flags.AutoRock100k then fireProximityPromptOnParts("100k") fireRemoteOnPart("100k") end
        if flags.AutoRock350k then fireProximityPromptOnParts("350k") fireRemoteOnPart("350k") end
        if flags.AutoRock750k then fireProximityPromptOnParts("750k") fireRemoteOnPart("750k") end
        if flags.AutoRock1m then fireProximityPromptOnParts("1m") fireRemoteOnPart("1m") end
        if flags.AutoRock10m then fireProximityPromptOnParts("10m") fireRemoteOnPart("10m") end
        if flags.TeleKing then
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Name:lower():find("king") then
                    teleportTo(v)
                    break
                end
            end
        end
        if flags.TeleAllIslands then
            local islands = {}
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Name:lower():find("island") then
                    table.insert(islands, v)
                end
            end
            for _, part in ipairs(islands) do
                teleportTo(part)
                task.wait(1)
            end
        end
        if flags.BuyBlueCrystal then fireProximityPromptOnParts("bluecrystal") fireRemoteOnPart("bluecrystal") end
        if flags.BuyGreenCrystal then fireProximityPromptOnParts("greencrystal") fireRemoteOnPart("greencrystal") end
        if flags.BuyDarkstar then fireProximityPromptOnParts("darkstar") fireRemoteOnPart("darkstar") end
        if flags.AutoEvolve then
            local evolveBtn = playerGui:FindFirstChild("EvolveButton") or playerGui:FindFirstChild("Evolve")
            if evolveBtn and evolveBtn:IsA("TextButton") and evolveBtn.Visible then
                pcall(function() evolveBtn.MouseButton1Click:Fire() end)
            end
            fireRemoteOnPart("evolve")
        end
        task.wait(0.5)
    end
end

-- Khởi tạo các vòng lặp không ngừng (per-frame)
local function startLoops()
    loops.SpeedJump = RunService.Heartbeat:Connect(function()
        if humanoid then
            if flags.SpeedBoost then humanoid.WalkSpeed = 120 else humanoid.WalkSpeed = 16 end
            if flags.JumpPower then humanoid.JumpPower = 150 else humanoid.JumpPower = 50 end
        end
    end)

    loops.Fly = RunService.Heartbeat:Connect(function()
        if not humanoid or not rootPart then return end
        if flags.Fly then
            if not flyGyro then
                flyGyro = Instance.new("BodyGyro")
                flyGyro.P = 9e4
                flyGyro.Parent = rootPart
                flyVel = Instance.new("BodyVelocity")
                flyVel.MaxForce = Vector3.new(9e9,9e9,9e9)
                flyVel.Parent = rootPart
            end
            flyGyro.CFrame = workspace.CurrentCamera.CFrame
            local dir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += workspace.CurrentCamera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= workspace.CurrentCamera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= workspace.CurrentCamera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += workspace.CurrentCamera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
            flyVel.Velocity = dir * 80
        else
            if flyGyro then flyGyro:Destroy() flyVel:Destroy() flyGyro, flyVel = nil, nil end
        end
    end)

    loops.Noclip = RunService.Stepped:Connect(function()
        if flags.Noclip and character then
            for _, p in ipairs(character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        end
    end)

    loops.LongPunch = RunService.Heartbeat:Connect(function()
        if flags.LongPunch then
            local tool = findTool("punch") or findTool("boxing") or findTool("fight")
            if tool then
                if tool.Parent == player.Backpack then humanoid:EquipTool(tool)
                elseif tool.Parent == character then tool:Activate()
                end
                local remote = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("ActivateRemote")
                if remote then remote:FireServer() end
            end
        end
    end)

    local fpsApplied = false
    loops.FPS = RunService.Heartbeat:Connect(function()
        if flags.FPSUnlock and not fpsApplied then
            pcall(function() setfpscap(240) end)
            fpsApplied = true
        elseif not flags.FPSUnlock then
            fpsApplied = false
        end
    end)

    local lowApplied = false
    loops.LowGraphics = RunService.Heartbeat:Connect(function()
        if flags.LowGraphics and not lowApplied then
            pcall(function() game:GetService("UserGameSettings"):SetGraphicsQuality(1) end)
            lowApplied = true
        elseif not flags.LowGraphics then
            lowApplied = false
        end
    end)

    loops.AntiAFK = RunService.Heartbeat:Connect(function()
        if flags.AntiAFK then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:MoveMouse(Vector2.new(math.random(1,100), math.random(1,100)))
            end)
        end
    end)

    task.spawn(mainLoop)
end

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    if flyGyro then flyGyro:Destroy() flyVel:Destroy() flyGyro, flyVel = nil, nil end
end)

local function checkKey()
    if keyBox.Text:lower() == "geckomus" then
        keyFrame:Destroy()
        createMainGUI()
        startLoops()
    else
        statusLbl.Text = "Wrong key"
    end
end

unlockBtn.MouseButton1Click:Connect(checkKey)
keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then checkKey() end
end)
