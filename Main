	rebirthInfo.Font = Enum.Font.GothamMedium
	rebirthInfo.TextXAlignment = Enum.TextXAlignment.Left
	rebirthInfo.Parent = mainContent

	local targetInfo = Instance.new("TextLabel")
	targetInfo.Size = UDim2.new(1, -30, 0, 30)
	targetInfo.Position = UDim2.fromOffset(15, 345)
	targetInfo.BackgroundTransparency = 1
	targetInfo.Text = "Target: 0"
	targetInfo.TextColor3 = TEXT_DIM
	targetInfo.TextSize = 18
	targetInfo.Font = Enum.Font.GothamMedium
	targetInfo.TextXAlignment = Enum.TextXAlignment.Left
	targetInfo.Parent = mainContent

	local targetBox = Instance.new("TextBox")
	targetBox.Size = UDim2.fromOffset(180, 45)
	targetBox.Position = UDim2.fromOffset(15, 385)
	targetBox.BackgroundColor3 = BG_LIGHT
	targetBox.PlaceholderText = "Target..."
	targetBox.PlaceholderColor3 = TEXT_DIM
	targetBox.Text = ""
	targetBox.TextColor3 = TEXT
	targetBox.TextSize = 19
	targetBox.Font = Enum.Font.Gotham
	targetBox.Parent = mainContent
	corner(targetBox, 12)

	local autoRebirthBtn = createToggle(mainContent, "Auto Rebirth", 385, "AutoRebirth")
	autoRebirthBtn.Position = UDim2.fromOffset(210, 385)
	autoRebirthBtn.Size = UDim2.new(1, -235, 0, 45)

	local farmContent = createContentFrame("Farm")
	createToggle(farmContent, "Speed Boost", 15, "SpeedBoost")
	createToggle(farmContent, "Jump Power", 80, "JumpPower")
	createToggle(farmContent, "Fly", 145, "Fly")
	createToggle(farmContent, "Noclip", 210, "Noclip")
	createToggle(farmContent, "Auto Farm", 275, "AutoFarm")

	local miscContent = createContentFrame("Misc")
	createToggle(miscContent, "FPS Unlocker", 15, "FPSUnlock")
	createToggle(miscContent, "Low Graphics", 80, "LowGraphics")
	createToggle(miscContent, "Anti AFK", 145, "AntiAFK")

	tween(main, 0.4, { BackgroundTransparency = 0.05 })
end

local checking = false
local function checkKey()
	if checking then return end
	local input = keyBox.Text:lower():gsub("%s+", "")
	if input == "geckomus" then
		checking = true
		status.TextColor3 = Color3.fromRGB(110, 220, 140)
		status.Text = "Key accepted"
		task.wait(0.3)
		tween(keyFrame, 0.4, { Size = UDim2.fromOffset(480, 320), BackgroundTransparency = 1 })
		task.wait(0.4)
		keyFrame:Destroy()
		showMain()
	else
		status.TextColor3 = Color3.fromRGB(255, 110, 110)
		status.Text = "Invalid key"
		local origPos = keyBox.Position
		for i = 1, 3 do
			tween(keyBox, 0.08, { Position = UDim2.fromOffset(origPos.X.Offset - 4, origPos.Y.Offset) })
			task.wait(0.1)
			tween(keyBox, 0.08, { Position = UDim2.fromOffset(origPos.X.Offset + 4, origPos.Y.Offset) })
			task.wait(0.1)
		end
		tween(keyBox, 0.08, { Position = origPos })
	end
end

mainButton.MouseButton1Click:Connect(checkKey)
keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then checkKey() end
end)
