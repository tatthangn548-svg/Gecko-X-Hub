local function showMain()
	local main = Instance.new("Frame")
	main.Size = UDim2.fromOffset(700, 480)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.BackgroundColor3 = BG_DARK
	main.BackgroundTransparency = 1
	main.Parent = gui
	corner(main, 22)
	stroke(main, 1.5, 0.85)

	local header = Instance.new("Frame")
	header.Size = UDim2.new(1, 0, 0, 60)
	header.BackgroundColor3 = BG_MEDIUM
	header.Parent = main
	corner(header, 22)

	local headerFix = Instance.new("Frame")
	headerFix.Size = UDim2.new(1, 0, 0, 25)
	headerFix.Position = UDim2.new(0, 0, 1, -25)
	headerFix.BackgroundColor3 = BG_MEDIUM
	headerFix.BorderSizePixel = 0
	headerFix.Parent = header

	local headerTitle = Instance.new("TextLabel")
	headerTitle.Size = UDim2.new(1, -120, 1, 0)
	headerTitle.Position = UDim2.fromOffset(20, 0)
	headerTitle.BackgroundTransparency = 1
	headerTitle.Text = "GeckoMus | Main"
	headerTitle.TextColor3 = TEXT
	headerTitle.TextSize = 24
	headerTitle.Font = Enum.Font.GothamBold
	headerTitle.TextXAlignment = Enum.TextXAlignment.Left
	headerTitle.Parent = header

	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.fromOffset(35, 35)
	closeBtn.Position = UDim2.new(1, -50, 0, 12)
	closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "×"
	closeBtn.TextColor3 = TEXT
	closeBtn.TextSize = 30
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.Parent = header
	closeBtn.MouseButton1Click:Connect(function()
		gui:Destroy()
		flags = {}
	end)

	local sidebar = Instance.new("Frame")
	sidebar.Size = UDim2.new(0, 150, 1, -80)
	sidebar.Position = UDim2.fromOffset(15, 70)
	sidebar.BackgroundColor3 = BG_MEDIUM
	sidebar.Parent = main
	corner(sidebar, 18)

	local tabs = {}
	local function selectTab(tabName)
		for _, btn in ipairs(tabs) do
			btn.BackgroundColor3 = btn.Name == tabName and ACCENT or BG_LIGHT
			btn.TextColor3 = btn.Name == tabName and Color3.fromRGB(255,255,255) or TEXT
		end
		for _, frame in ipairs(main:GetChildren()) do
			if frame:IsA("Frame") and frame.Name:match("^Content_") then
				frame.Visible = (frame.Name == "Content_"..tabName)
			end
		end
	end

	local function createTabButton(name, yPos)
		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.Size = UDim2.new(1, -20, 0, 45)
		btn.Position = UDim2.fromOffset(10, yPos)
		btn.BackgroundColor3 = name == "Main" and ACCENT or BG_LIGHT
		btn.Text = name
		btn.TextColor3 = name == "Main" and Color3.fromRGB(255,255,255) or TEXT
		btn.TextSize = 20
		btn.Font = Enum.Font.GothamBold
		btn.Parent = sidebar
		corner(btn, 12)
		btn.MouseButton1Click:Connect(function()
			selectTab(name)
		end)
		table.insert(tabs, btn)
		return btn
	end

	createTabButton("Main", 15)
	createTabButton("Farm", 75)
	createTabButton("Misc", 135)

	local contentContainer = Instance.new("Frame")
	contentContainer.Size = UDim2.new(1, -195, 1, -95)
	contentContainer.Position = UDim2.fromOffset(175, 75)
	contentContainer.BackgroundTransparency = 1
	contentContainer.Parent = main

	local function createContentFrame(tabName)
		local frame = Instance.new("Frame")
		frame.Name = "Content_"..tabName
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = BG_MEDIUM
		frame.BackgroundTransparency = 0.8
		frame.Visible = (tabName == "Main")
		frame.Parent = contentContainer
		corner(frame, 16)
		return frame
	end

	local function createToggle(parent, text, y, flagName)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -30, 0, 50)
		button.Position = UDim2.fromOffset(15, y)
		button.BackgroundColor3 = BG_LIGHT
		button.Text = "OFF    " .. text
		button.TextColor3 = Color3.fromRGB(245, 245, 250)
		button.TextSize = 19
		button.Font = Enum.Font.GothamMedium
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Parent = parent
		corner(button, 12)

		local enabled = false
		flags[flagName] = false

		button.MouseButton1Click:Connect(function()
			enabled = not enabled
			flags[flagName] = enabled
			button.Text = (enabled and "ON     " or "OFF    ") .. text
			button.BackgroundColor3 = enabled and Color3.fromRGB(90, 140, 100) or BG_LIGHT
		end)
		return button
	end

	local mainContent = createContentFrame("Main")
	createToggle(mainContent, "Auto Lift", 15, "AutoLift")
	createToggle(mainContent, "Auto Punch", 80, "AutoPunch")
	createToggle(mainContent, "Auto Egg", 145, "AutoEgg")
	createToggle(mainContent, "Auto Sell", 210, "AutoSell")

